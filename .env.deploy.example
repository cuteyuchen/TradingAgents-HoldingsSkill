ADVISOR_TOKEN=adv_replace_me_with_a_real_token
APP_SECRET_KEY=replace_with_a_stable_random_secret_at_least_32_bytes
ALLOW_REGISTRATION=true

# GHCR image settings.
GHCR_OWNER=cuteyuchen
IMAGE_TAG=latest

# Both ports reach the same application container. BACKEND_PORT keeps legacy
# /api/v1 integrations working; FRONTEND_PORT is the primary browser address.
BACKEND_PORT=18000
FRONTEND_PORT=18080
PUBLIC_APP_URL=http://192.168.1.13:18080

ADVISOR_CORS_ORIGINS=http://192.168.1.13:18080,http://192.168.1.13:18000,http://localhost:18080,http://localhost:18000
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
ANALYSIS_HISTORY_LIMIT=5
MAX_UPLOAD_BYTES=12582912

# Phase K release metadata and self-hosted operations.
APP_VERSION=0.3.0
APP_GIT_SHA=
APP_BUILD_TIME=
ADVISOR_BACKUP_DIR=/app/data/backups
BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_TIME=20:45
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_PRE_UPGRADE=5
BACKUP_DEGRADED_HOURS=36
BACKUP_BLOCKED_HOURS=72
DISK_DEGRADED_RATIO=0.10
DISK_BLOCKED_RATIO=0.03
DIAGNOSTIC_LOG_LINES=2000

# Market-data foundation. Keep automatic remote synchronization disabled until
# the deployment has selected and validated its providers.
MARKET_QUOTE_ALL_A_PRIMARY_PROVIDER=eastmoney_batch
MARKET_QUOTE_ALL_A_FALLBACK_PROVIDERS=tencent
MARKET_QUOTE_CRITICAL_PRIMARY_PROVIDER=tencent
MARKET_QUOTE_CRITICAL_FALLBACK_PROVIDERS=eastmoney_batch
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
QUOTE_FRESHNESS_SECONDS=90
MARKET_SNAPSHOT_FRESHNESS_SECONDS=120
MARKET_QUOTE_CONFLICT_THRESHOLD_PCT=0.5
EASTMONEY_MIN_INTERVAL_SECONDS=0.8
SECURITY_MASTER_SYNC_ENABLED=false
CALENDAR_SYNC_ENABLED=false
CALENDAR_BOOTSTRAP_ENABLED=true
CALENDAR_SYNC_PROVIDER=eastmoney_sse_calendar
CALENDAR_SYNC_LOOKBACK_DAYS=370
SECURITY_MASTER_SYNC_PROVIDER=eastmoney_security
# Global identity sync writes require this separate internal/operator token.
MARKET_IDENTITY_SYNC_TOKEN=replace_with_a_long_internal_sync_token

# 模型调用超时与重试。推理型模型思考期间不产生任何输出，非流式请求容易被误判超时；
# 保持 MODEL_STREAM_DEFAULT=true 时读超时只约束数据块之间的静默间隔。
MODEL_CONNECT_TIMEOUT=15
MODEL_READ_TIMEOUT=600
MODEL_STREAM_IDLE_TIMEOUT=180
MODEL_STREAM_DEFAULT=true
MODEL_MAX_RETRIES=1
